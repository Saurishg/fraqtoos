# GENERATED by fraqtoos/ops/gen_units.py from registry.json — do not hand-edit.
[Unit]
Description=CardWise Sync - bank alerts in, card statements verified (timer)

[Timer]
OnCalendar=*-*-* 10:30:00
OnCalendar=*-*-* 21:30:00
# The whole reason for this migration: if the machine was down or rebooting at
# the scheduled minute, run as soon as it is back rather than skipping the day.
Persistent=true
AccuracySec=30s
Unit=fraqtoos-cardwise.service

[Install]
WantedBy=timers.target
