[Unit]
Description=IPO Bot - last-day alert (GMP >= 30%) (timer)

[Timer]
OnCalendar=*-*-* 10:10:00
# The whole reason for this migration: if the machine was down or rebooting at
# the scheduled minute, run as soon as it is back rather than skipping the day.
Persistent=true
AccuracySec=30s
Unit=fraqtoos-ipo.service

[Install]
WantedBy=timers.target
