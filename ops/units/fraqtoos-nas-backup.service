# GENERATED by fraqtoos/ops/gen_units.py from registry.json — do not hand-edit.
# Change the registry entry and regenerate, or the schedule and the monitoring
# will drift apart, which is the problem this whole layer exists to remove.
[Unit]
Description=NAS backup - nightly rsync to the QNAP
After=network-online.target
Wants=network-online.target
OnFailure=fraqtoos-alert@%n.service

[Service]
Type=oneshot
User=work
WorkingDirectory=/home/work/.server-backup
Environment=DISPLAY=:0
# Exit 4 means "ran, but a data source was missing". Left OUT of
# SuccessExitStatus on purpose, so systemd records the run as failed and an
# incomplete result stays visible to OnFailure and to the registry sweep.
ExecStart=/home/work/.server-backup/run-backup.sh
TimeoutStartSec=7200
