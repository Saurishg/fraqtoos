[Unit]
Description=Links page - regenerate redirects and publish
After=network-online.target
Wants=network-online.target
# No OnFailure: failures surface through the registry sweep
# instead, deduped, rather than paging on every run.

[Service]
Type=oneshot
User=work
WorkingDirectory=/home/work/links-page
Environment=DISPLAY=:0
# Exit 4 means "ran, but a data source was missing". Left OUT of
# SuccessExitStatus on purpose, so systemd records the run as failed and an
# incomplete result stays visible to OnFailure and to the registry sweep.
ExecStart=/bin/bash -c '/home/work/links-page/update_urls.sh >> /home/work/links-page/update.log 2>&1'
TimeoutStartSec=240
