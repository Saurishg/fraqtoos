[Unit]
Description=IPO Bot - allotment checker (Kite applications)
After=network-online.target
Wants=network-online.target
OnFailure=fraqtoos-alert@%n.service

[Service]
Type=oneshot
User=work
WorkingDirectory=/home/work/ipo-bot
Environment=DISPLAY=:0
# Exit 4 means "sent, but a source was missing". Left OUT of SuccessExitStatus
# on purpose: an incomplete report must still reach OnFailure and still page.
ExecStart=/home/work/.venvs/portfolio/bin/python ipo_allotment.py
TimeoutStartSec=300
