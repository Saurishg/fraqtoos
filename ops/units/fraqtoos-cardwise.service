[Unit]
Description=CardWise Sync - bank alerts in, card statements verified
After=network-online.target
Wants=network-online.target
OnFailure=fraqtoos-alert@%n.service

[Service]
Type=oneshot
User=work
WorkingDirectory=/home/work/cardwise-sync
Environment=DISPLAY=:0
# Exit 4 means "ran, but a data source was missing". Left OUT of
# SuccessExitStatus on purpose, so systemd records the run as failed and an
# incomplete result stays visible to OnFailure and to the registry sweep.
ExecStart=/home/work/.venvs/fraqtoos-chat/bin/python cardwise_sync.py
TimeoutStartSec=600
