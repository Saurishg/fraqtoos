{
  "_about": [
    "Single source of truth for everything scheduled or long-running on this server.",
    "Written 2026-09-01. Before this, five independent schedulers each held part of the",
    "picture and nothing held all of it, so the watchdog covered 6 of 31 entries and",
    "drifted every time a bot was added.",
    "",
    "The watchdog reads THIS file. Adding a job here is what makes it monitored.",
    "",
    "kind decides how health is probed - no job needs to be instrumented for it:",
    "  orchestrator : ran by fraqtoos orchestrator; probed from logs/state.json",
    "  service      : systemd unit expected active; probed with systemctl is-active",
    "  timer        : systemd timer; probed from LastTriggerUSec + the unit's Result",
    "  pm2          : pm2-managed app; probed from `pm2 jlist` status + restart count",
    "  cron         : crontab entry; probed from the mtime of the log it writes",
    "",
    "max_age_h is how long the job may go without a successful run before it is stale.",
    "Set it to roughly twice the interval, so one missed run is tolerated and two are not.",
    "critical=true means a failure pages over BOTH channels (WhatsApp + ntfy)."
  ],
  "jobs": [
    {
      "name": "Orchestrator",
      "kind": "service",
      "unit": "fraqtoos.service",
      "critical": true,
      "note": "owns every orchestrator-kind job below; if it is down, none of them run"
    },
    {
      "name": "WhatsApp Service",
      "kind": "service",
      "unit": "wa-service.service",
      "critical": true,
      "note": "primary alert path; 5h51m silent outage 2026-08-16"
    },
    {
      "name": "Ollama",
      "kind": "service",
      "unit": "ollama.service",
      "critical": false,
      "note": "AI briefs degrade without it; bots still send"
    },
    {
      "name": "FraqtoOS Chat",
      "kind": "service",
      "unit": "fraqtoos-chat.service",
      "critical": false
    },
    {
      "name": "Grafana WA Bridge",
      "kind": "service",
      "unit": "grafana-wa-bridge.service",
      "critical": false
    },
    {
      "name": "DeepSeek Harness Web",
      "kind": "service",
      "unit": "dsh-web.service",
      "critical": false
    },
    {
      "name": "Prometheus",
      "kind": "service",
      "unit": "prometheus.service",
      "critical": false
    },
    {
      "name": "Grafana",
      "kind": "service",
      "unit": "grafana-server.service",
      "critical": false
    },
    {
      "name": "Chia Exporter",
      "kind": "service",
      "unit": "chia_exporter.service",
      "critical": false
    },
    {
      "name": "NAS Exporter",
      "kind": "service",
      "unit": "nas_exporter.service",
      "critical": false
    },
    {
      "name": "Node Exporter",
      "kind": "service",
      "unit": "node_exporter.service",
      "critical": false
    },
    {
      "name": "NVIDIA GPU Exporter",
      "kind": "service",
      "unit": "nvidia_gpu_exporter.service",
      "critical": false
    },
    {
      "name": "IPMI Exporter",
      "kind": "service",
      "unit": "ipmi_exporter.service",
      "critical": false
    },
    {
      "name": "Tunnel: Chat",
      "kind": "service",
      "unit": "cloudflared-chat.service",
      "critical": false
    },
    {
      "name": "Tunnel: Dashboard",
      "kind": "service",
      "unit": "cloudflared-dashboard.service",
      "critical": false
    },
    {
      "name": "Tunnel: Grafana",
      "kind": "service",
      "unit": "cloudflared-grafana.service",
      "critical": false
    },
    {
      "name": "Tunnel: Obsidian",
      "kind": "service",
      "unit": "cloudflared-obsidian.service",
      "critical": false
    },
    {
      "name": "Portfolio Bot",
      "kind": "orchestrator",
      "state_key": "Portfolio Bot",
      "schedule": "06:00",
      "max_age_h": 30,
      "critical": false
    },
    {
      "name": "Chia Health Monitor",
      "kind": "orchestrator",
      "state_key": "Chia Health Monitor",
      "schedule": "08:00",
      "max_age_h": 30,
      "critical": false
    },
    {
      "name": "Crypto Portfolio Bot",
      "kind": "orchestrator",
      "state_key": "Crypto Portfolio Bot",
      "schedule": "09:00, 21:00",
      "max_age_h": 15,
      "critical": false
    },
    {
      "name": "IPO Last-Day Alert",
      "kind": "timer",
      "unit": "fraqtoos-ipo.timer",
      "schedule": "10:10",
      "max_age_h": 30,
      "critical": false,
      "note": "Migrated off the orchestrator loop 2026-09-01 (Phase 3 pilot). Silent when nothing matches - a quiet run is still a successful run.",
      "systemd": {
        "description": "IPO Bot - last-day alert (GMP >= 30%)",
        "exec": "/usr/bin/python3.12 ipo_bot.py --min-gmp 30 --closing-today",
        "cwd": "/home/work/ipo-bot",
        "on_calendar": "*-*-* 10:10:00",
        "timeout_sec": 240
      }
    },
    {
      "name": "IPO Allotment Checker",
      "kind": "timer",
      "unit": "fraqtoos-ipo-allotment.timer",
      "schedule": "18:00, 21:30",
      "max_age_h": 30,
      "critical": false,
      "note": "Reads Kite's own IPO applications (no PAN, no registrar captcha). Announces a status only once; silent runs are normal.",
      "systemd": {
        "description": "IPO Bot - allotment checker (Kite applications)",
        "exec": "/home/work/.venvs/portfolio/bin/python ipo_allotment.py",
        "cwd": "/home/work/ipo-bot",
        "on_calendar": [
          "*-*-* 18:00:00",
          "*-*-* 21:30:00"
        ],
        "timeout_sec": 300
      }
    },
    {
      "name": "Chia AI Watcher",
      "kind": "orchestrator",
      "state_key": "Chia AI Watcher",
      "schedule": "every 2h",
      "max_age_h": 6,
      "critical": false
    },
    {
      "name": "Utility Bill Bot",
      "kind": "pm2",
      "app": "utility-bill-bot",
      "critical": false,
      "note": "sole owner of its schedule since 2026-09-01: internal node-cron at 09:00"
    },
    {
      "name": "Chia Win Notifier",
      "kind": "pm2",
      "app": "chia-win-notifier",
      "critical": false
    },
    {
      "name": "Creator Dashboard",
      "kind": "pm2",
      "app": "creator-dashboard",
      "critical": false
    },
    {
      "name": "pm2 logrotate",
      "kind": "pm2",
      "app": "pm2-logrotate",
      "critical": false
    },
    {
      "name": "SMART metrics",
      "kind": "timer",
      "unit": "smartmon.timer",
      "max_age_h": 1,
      "critical": false
    },
    {
      "name": "SMART fleet watch",
      "kind": "timer",
      "unit": "smart-watch.timer",
      "max_age_h": 2,
      "critical": false
    },
    {
      "name": "Root disk watch",
      "kind": "timer",
      "unit": "root-disk-watch.timer",
      "max_age_h": 1,
      "critical": false
    },
    {
      "name": "Tunnel health",
      "kind": "timer",
      "unit": "tunnel-health.timer",
      "max_age_h": 2,
      "critical": false
    },
    {
      "name": "Tunnel latency",
      "kind": "timer",
      "unit": "tunnel-latency.timer",
      "max_age_h": 1,
      "critical": false
    },
    {
      "name": "I350 BAR recover",
      "kind": "timer",
      "unit": "i350-bar-recover.timer",
      "max_age_h": 2,
      "critical": false
    },
    {
      "name": "Drive self-test",
      "kind": "timer",
      "unit": "drive-selftest.timer",
      "max_age_h": 30,
      "critical": false
    },
    {
      "name": "NAS mount heal",
      "kind": "timer",
      "unit": "nas-mount-heal.timer",
      "max_age_h": 2,
      "critical": false
    },
    {
      "name": "Odysseus healthcheck",
      "kind": "timer",
      "unit": "odysseus-healthcheck.timer",
      "max_age_h": 30,
      "critical": false,
      "note": "OnCalendar=daily (~00:03) — a 2h budget was a registry error, not a fault"
    },
    {
      "name": "Links page publish",
      "kind": "cron",
      "log": "/home/work/links-page/update.log",
      "schedule": "every 5m",
      "max_age_h": 1,
      "critical": false
    },
    {
      "name": "Obsidian vault sync",
      "kind": "cron",
      "log": "/home/work/obsidian-app/logs/update_vault.log",
      "schedule": "every 30m",
      "max_age_h": 2,
      "critical": false
    },
    {
      "name": "NAS backup",
      "kind": "cron",
      "log": "/home/work/.server-backup/last-run.log",
      "schedule": "03:00",
      "max_age_h": 30,
      "critical": false,
      "note": "already raises its own ntfy alert on failure"
    }
  ]
}
